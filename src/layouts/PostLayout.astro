---
import BaseLayout from "./BaseLayout.astro";
import { formatDate, isoDate, readingTime } from "../utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags } = post.data;
---

<BaseLayout title={title} description={description}>
  <article class="post wrap">
    <nav class="post__back"><a href="/blog" class="label">&larr; All posts</a></nav>

    <header class="post__header">
      <div class="post__meta">
        <a href={`/categories/${category.toLowerCase()}`} class="label accent post__cat">{category}</a>
        <time class="label" datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        <span class="label">{readingTime(post.body)}</span>
      </div>
      <h1 class="post__title">{title}</h1>
      <p class="post__desc">{description}</p>
      {
        updatedDate && (
          <p class="label post__updated">Updated {formatDate(updatedDate)}</p>
        )
      }
    </header>

    <hr class="hr" />

    <div class="content">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <footer class="post__tags">
          <span class="label">Tags:</span>
          {tags.map((t) => <span class="tag">{t}</span>)}
        </footer>
      )
    }
  </article>
</BaseLayout>

<style>
  .post { padding-top: clamp(28px, 4vw, 48px); max-width: 760px; }
  .post__back { margin-bottom: 24px; }
  .post__back a { text-decoration: none; color: var(--ink-soft); }
  .post__back a:hover { background: var(--accent); color: var(--paper); }

  .post__meta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .post__cat { text-decoration: none; }
  .post__cat:hover { background: var(--accent); color: var(--paper); }
  .post__title { margin-top: 16px; }
  .post__desc { margin-top: 16px; font-size: 1.2rem; color: var(--ink-soft); }
  .post__updated { margin-top: 10px; }

  .post__tags {
    margin-top: clamp(32px, 5vw, 56px);
    padding-top: 20px;
    border-top: 2px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
</style>
